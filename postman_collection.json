{
  "info": {
    "name": "Metasys Forms API",
    "description": "API collection for Metasys form submissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Contact Form",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1-555-0123\",\n  \"company\": \"Tech Corp\",\n  \"message\": \"I would like to discuss a potential project collaboration.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/forms/contact",
          "host": ["{{baseUrl}}"],
          "path": ["api", "forms", "contact"]
        }
      }
    },
    {
      "name": "Proposal Form",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"email\": \"jane.smith@company.com\",\n  \"phone\": \"+1-555-0456\",\n  \"company\": \"Innovation Inc\",\n  \"projectType\": \"web\",\n  \"budget\": \"$50k-$100k\",\n  \"timeline\": \"3-6 months\",\n  \"description\": \"We need a modern e-commerce platform with AI recommendations.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/forms/proposal",
          "host": ["{{baseUrl}}"],
          "path": ["api", "forms", "proposal"]
        }
      }
    },
    {
      "name": "Proposal Form with File",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "firstName",
              "value": "Jane",
              "type": "text"
            },
            {
              "key": "lastName",
              "value": "Smith",
              "type": "text"
            },
            {
              "key": "email",
              "value": "jane.smith@company.com",
              "type": "text"
            },
            {
              "key": "phone",
              "value": "+1-555-0456",
              "type": "text"
            },
            {
              "key": "company",
              "value": "Innovation Inc",
              "type": "text"
            },
            {
              "key": "projectType",
              "value": "web",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Modern e-commerce platform",
              "type": "text"
            },
            {
              "key": "resumeFile",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/forms/proposal",
          "host": ["{{baseUrl}}"],
          "path": ["api", "forms", "proposal"]
        }
      }
    },
    {
      "name": "Newsletter Subscribe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"subscriber@example.com\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Johnson\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/forms/newsletter",
