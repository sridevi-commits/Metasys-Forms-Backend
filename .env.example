# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/metasys_forms?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Configuration (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=metasys-resumes

# Email Configuration (Postmark)
# Get your API key from: https://postmarkapp.com
POSTMARK_API_KEY=your_postmark_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Email Recipients
CONTACT_EMAIL=contact@yourdomain.com
PROPOSAL_EMAIL=proposals@yourdomain.com
NEWSLETTER_EMAIL=newsletter@yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Optional: Skip email sending in development
# SKIP_EMAIL=true