dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Prisma
prisma/migrations/*_migration.sql
prisma/migrations/migration_lock.toml

# Temporary files
tmp/
temp/
*.tmp

# MinIO data
minio-data/